# ── Application ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for development:
DATABASE_URL=sqlite+aiosqlite:///./hireiq.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hireiq

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your@gmail.com

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=hireiq-resumes
AWS_REGION=us-east-1

# ── ML Config ────────────────────────────────────────────────────────────────
SBERT_MODEL=all-MiniLM-L6-v2
UPLOAD_DIR=uploads
MODELS_DIR=trained
DATASETS_DIR=datasets
EMBEDDINGS_DIR=embeddings

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001

# ── App Settings ─────────────────────────────────────────────────────────────
DEBUG=true
AUTO_VERIFY_EMAIL=true  # set false in production
MAX_FILE_SIZE_MB=10
